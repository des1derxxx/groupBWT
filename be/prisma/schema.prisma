// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Users { 

  id String @id @default(uuid())
  firstname String?
  lastname String ?
  email String @unique
  password String 
  createdAt DateTime @default(now())

  galleries Galleries[]
  chatMessage ChatMessage[]
  galleryMembers GalleryMember[]

}

model Galleries {

  id String @id @default(uuid())
  title String 
  description String?
  createdAt DateTime @default(now())
  imagesCount Int      @default(0)

  userId   String
  user     Users @relation(fields: [userId], references: [id])

  images Images[]
  members GalleryMember[]

}

model Images { 

  id String @id @default(uuid())
  path String
  originalFilename String
  createdAt DateTime @default(now())

  galleryId String  
  gallery Galleries @relation(fields: [galleryId], references: [id])

}

model ChatMessage {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())

  userId String
  user     Users @relation(fields: [userId], references: [id])

  @@index([createdAt])
}

enum GalleryRole {
  VIEW_ONLY
  FULL_ACCESS
}

model GalleryMember {
  id String @id @default(uuid())
  role GalleryRole @default(VIEW_ONLY)
  createdAt DateTime @default(now())

  userId String
  user Users @relation(fields: [userId], references: [id])

  galleryId String
  gallery Galleries @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  @@unique([userId, galleryId])
  @@index([galleryId])
  @@index([userId])
}
